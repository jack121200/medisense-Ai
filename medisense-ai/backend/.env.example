# ============================================================
# MediSense AI — Environment Variables (template)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is gitignored.
# ============================================================

# Backend
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://medisense:CHANGE_ME@localhost:5432/medisense_db

# Redis
REDIS_URL=redis://:CHANGE_ME@localhost:6379
REDIS_PASSWORD=CHANGE_ME

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_different_from_access
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_INTERNAL_KEY=CHANGE_ME

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_VITALS_TOPIC=patient-vitals
KAFKA_ALERTS_TOPIC=medical-alerts

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=medisense-files

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# Python ML Service
PYTHON_PORT=8000
MODEL_PATH=./app/models
MLFLOW_TRACKING_URI=http://localhost:5001

# PostgreSQL (for Docker)
POSTGRES_DB=medisense_db
POSTGRES_USER=medisense
POSTGRES_PASSWORD=CHANGE_ME

# Vapi (voice AI) — https://dashboard.vapi.ai
VAPI_API_KEY=CHANGE_ME
VAPI_PUBLIC_KEY=CHANGE_ME
VAPI_WEBHOOK_SECRET=CHANGE_ME

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.0-flash

# Groq — https://console.groq.com/keys
GROQ_API_KEY=CHANGE_ME

# Seed data (Phase 1.5 — no hardcoded fallback password allowed)
SEED_DEFAULT_PASSWORD=CHANGE_ME_or_leave_unset_to_auto_generate
