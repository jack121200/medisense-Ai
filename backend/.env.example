# ============================================================
# MediSense AI — Environment Variables (template)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is gitignored.
#
# Every variable below is actually read by some part of the app — this
# file previously listed KAFKA_*/ELASTICSEARCH_URL/MINIO_*/GEMINI_*/
# PYTHON_PORT/MLFLOW_TRACKING_URI/SEED_DEFAULT_PASSWORD, none of which
# any code in this repo consumes (confirmed by grep). Kafka, Elasticsearch,
# and MinIO's containers were removed from docker-compose.yml entirely for
# the same reason — see the comment at the top of that file.
# ============================================================

# Backend
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://medisense:CHANGE_ME@localhost:5432/medisense_db
POSTGRES_DB=medisense_db
POSTGRES_USER=medisense
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_URL=redis://:CHANGE_ME@localhost:6379
REDIS_PASSWORD=CHANGE_ME

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_different_from_access
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ML Service
ML_SERVICE_URL=http://localhost:8000
# Shared secret the backend sends as X-Internal-Service-Key on every
# request to ml-service — generate with: openssl rand -hex 32
ML_SERVICE_INTERNAL_KEY=CHANGE_ME
MODEL_PATH=./app/models

# Email (Nodemailer) — used for the forgot-password flow; if left unset,
# the reset link is logged instead of emailed (fine for local dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# Vapi (voice AI) — https://dashboard.vapi.ai
VAPI_API_KEY=CHANGE_ME
VAPI_PUBLIC_KEY=CHANGE_ME
# Must also be set as the assistant's "Server URL Secret" in the Vapi
# dashboard (Assistant -> Advanced) once you deploy with a public webhook
# URL — generate with: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=CHANGE_ME

# Groq — https://console.groq.com/keys (used for AI Doctor post-call reports)
GROQ_API_KEY=CHANGE_ME
