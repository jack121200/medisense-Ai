# ============================================================
# Environment / secrets — never commit real values
# ============================================================
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ============================================================
# Dependencies
# ============================================================
node_modules/
**/node_modules/

# ============================================================
# Build output
# ============================================================
dist/
build/
**/dist/
**/build/

# ============================================================
# Logs
# ============================================================
logs/
**/logs/
*.log
npm-debug.log*

# ============================================================
# Uploaded / generated files
# ============================================================
backend/uploads/
uploads/

# ============================================================
# Python / ML service
# ============================================================
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/
ml-service/**/*.pkl
ml-service/**/*.joblib
ml-service/**/*.pt
# Reproducible training-data cache built by prepare_ecg_dataset.py from
# PhysioNet — regenerate rather than commit (~7MB, derived, not source).
ml-service/data/mitbih_beats.npz
# DS1/DS2 inter-patient cache built by prepare_ecg_inter_patient.py.
ml-service/data/mitbih_inter_patient.npz

