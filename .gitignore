# =============================================================================
# MediSense AI — .gitignore
# Covers: Node.js, TypeScript, Python, Vite/React, Prisma, Docker, Windows
# =============================================================================

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12

# ─── Node.js / npm ───────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ─── TypeScript Build Outputs ────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─── Vite ────────────────────────────────────────────────────────────────────
.vite/
vite.config.ts.timestamp-*

# ─── Prisma ──────────────────────────────────────────────────────────────────
# Keep schema & migrations, ignore generated client
medisense-ai/backend/node_modules/.prisma/
medisense-ai/backend/src/generated/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*
medisense-ai/backend/logs/

# ─── Python / ML Service ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.env/
.python-version

# ML artifacts (large binaries)
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.bin
medisense-ai/ml-service/models/*.pkl
medisense-ai/ml-service/models/*.joblib
medisense-ai/ml-service/data/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ─── Docker ──────────────────────────────────────────────────────────────────
# Keep docker-compose.yml & Dockerfiles in source control
# Ignore local override files
docker-compose.override.yml
docker-compose.local.yml
.docker/

# ─── Database ────────────────────────────────────────────────────────────────
*.sql.bak
*.db
*.sqlite
*.sqlite3
pgdata/
postgres-data/

# ─── OS & Editor ─────────────────────────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code (keep launch & extensions, ignore local workspace settings)
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains IDEs
.idea/
*.iml

# ─── Misc / Temp Files ───────────────────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
coverage/
.nyc_output/
*.docx
*.xlsx
*.csv
docx_content.txt

# ─── CI/CD ───────────────────────────────────────────────────────────────────
.github/workflows/*.local.yml
